---
import type { Copy } from "../copy/index.ts";
import Points from "../components/Points.astro";
import { Text } from "../islands/dsx.ts";

interface Props {
  readonly copy: Copy;
}
const { copy } = Astro.props;
---

<section id="usher" class="scroll-mt-16 border-t border-border bg-brand-bg">
  <div class="mx-auto flex max-w-6xl flex-col gap-stack-lg px-gutter py-16 sm:py-24">
    <div class="flex flex-col gap-stack-sm">
      <Text variant="overline" tone="brand">{copy.usher.overline}</Text>
      <Text variant="title" as="h2" className="max-w-3xl text-balance">{copy.usher.title}</Text>
      <Text variant="body" tone="muted" className="max-w-2xl">{copy.usher.lede}</Text>
    </div>
    <Points points={copy.usher.points} />
    <Text variant="label" tone="brand">{copy.usher.status}</Text>
  </div>
</section>
