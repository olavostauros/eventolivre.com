---
/* Set in the B2B register. The density, accent and type scale change come
   from the design system, not from anything written here. */
import type { Copy } from "../copy/index.ts";
import Points from "../components/Points.astro";
import { Link, Text } from "../islands/dsx.ts";

interface Props {
  readonly copy: Copy;
}
const { copy } = Astro.props;
---

<section id="producers" data-register="b2b" class="scroll-mt-16 border-t border-border bg-surface-sunken">
  <div class="mx-auto flex max-w-6xl flex-col gap-stack-lg px-gutter py-16 sm:py-24">
    <div class="flex flex-col gap-stack-sm">
      <span class="h-1 w-12 rounded-full bg-accent-500" aria-hidden="true"></span>
      <Text variant="overline" tone="muted">{copy.producers.overline}</Text>
      <Text variant="heading" as="h2" className="max-w-3xl text-balance">{copy.producers.title}</Text>
      <Text variant="body" tone="muted" className="max-w-2xl">{copy.producers.lede}</Text>
    </div>
    <Points points={copy.producers.points} />
    <Link href="#contact" className="type-label">{copy.producers.cta}</Link>
  </div>
</section>
